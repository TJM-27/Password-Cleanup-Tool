{
  "name": "Potential password list cleanup options",
  "description": "Reusable filter rules used to clean up password lists",
  "line_rules": {
    "trim_whitespace": true,
    "drop_empty_lines": true,
    "dedupe": {
      "enabled": true,
      "case_sensitive": true
    },
    "ascii_only": true,
    "length": {
      "min": 4,
      "max": 48
    },
    "exclude_path_like": {
      "enabled": true,
      "regex": "[\\\\/].*[\\\\/]",
      "notes": "Looks like a path when two separators appear in one line"
    },
    "exclude_filename_like": {
      "enabled": true,
      "regex": "\\.[A-Za-z0-9]{1,5}$",
      "notes": "Ends with common short extension like .txt .exe"
    },
    "exclude_repeated_char_sequences": {
      "enabled": true,
      "regex": "([^\\d])\\1{3,}|(\\d)\\2{6,}",
      "notes": "Non-digits repeated 4+ times or digits repeated 7+ times consecutively"
    },
    "exclude_contains": {
      "enabled": true,
      "substrings": [
        "<EventRecordID>",
        "com_android",
        "name:",
        "com.samsung",
        "com.apple",
        "android.",
        "value:",
        "default:",
        "namespace",
        "security.",
        "ro.",
        "init.",
        "sys.",
        "dev.",
        "vendor.",
        "persist.",
        "print:"
      ]
    },
    "exclude_timestamp_or_datestamp": {
      "enabled": true,
      "regexes": [
        "\\b\\d{4}[-/]\\d{1,2}[-/]\\d{1,2}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\.\\d+)?(?:Z|[+-]\\d{2}:?\\d{2})?)?\\b",
        "\\b\\d{1,2}[-/]\\d{1,2}[-/]\\d{2,4}(?:[ T]\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\.\\d+)?)?\\b",
        "\\b\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\.\\d+)?\\b",
        "\\b\\d{1,2}:\\d{2}:\\d{2}:\\d{1,6}\\b",
        "\\b(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\\s+\\d{1,2},?\\s+\\d{2,4}\\b",
        "\\b\\d{10}\\b",
        "\\b\\d{13}\\b"
      ]
    }
  }
}